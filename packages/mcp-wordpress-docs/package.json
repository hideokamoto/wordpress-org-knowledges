{
  "name": "mcp-wordpress-docs",
  "version": "0.1.0",
  "description": "MCP server for searching WordPress developer documentation",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "mcp-wordpress-docs": "src/index.js"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node src/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "turndown": "7.2.5"
  },
  "devDependencies": {
    "@types/node": "22.20.7",
    "@types/turndown": "5.0.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hideokamoto/wordpress-org-knowledges"
